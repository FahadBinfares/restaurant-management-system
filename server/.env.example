# Local development only. These public sample credentials must never be reused
# outside this loopback-only development database.
POSTGRES_USER=restaurant_dev
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=restaurant_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://restaurant_dev:local-development-only@127.0.0.1:5433/restaurant_dev
HOST=127.0.0.1
PORT=3001
# development | test | staging | production. Staging/production default to
# Secure cookies and mandatory administrator MFA; production refuses to disable them.
APP_ENV=development
# Local HTTP development cannot use Secure cookies.
SECURE_COOKIES=false
REQUIRE_ADMIN_MFA=false
# true only when running behind exactly one reverse proxy (Nginx).
TRUST_PROXY=false
SESSION_MAX_HOURS=12
