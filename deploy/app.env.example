# Copy to app.env on the server (chmod 600). Never commit the real file.
# Use a least-privilege database role: it owns the schema for migrations but is
# not a superuser. Require TLS to the managed database.
DATABASE_URL=postgresql://rms_app:CHANGE_ME@managed-db.example.internal:5432/rms_production?sslmode=require
APP_ENV=production
SECURE_COOKIES=true
REQUIRE_ADMIN_MFA=true
SESSION_MAX_HOURS=12
