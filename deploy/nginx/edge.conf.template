# Edge proxy: TLS termination and blue/green switching.
# /etc/nginx/active/upstream.conf is rewritten by deploy.sh and contains
#   upstream app { server web-blue:8080; }   (or web-green)
include /etc/nginx/active/upstream.conf;

server {
  listen 80;
  server_name ${SERVER_NAME};
  server_tokens off;

  # Let's Encrypt HTTP-01 challenges (certbot --webroot -w /var/www/certbot).
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${SERVER_NAME};
  server_tokens off;

  ssl_certificate /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  client_max_body_size 512k;

  location / {
    proxy_pass http://app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # The API trusts exactly one proxy hop (TRUST_PROXY=true): this edge sets the client IP.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
  }
}
